{
  "name": "coloride-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @coloride/desktop-tauri tauri dev",
    "dev:web": "pnpm --filter @coloride/desktop-tauri dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "fetch:js-debug": "node scripts/fetch-js-debug.mjs",
    "build": "tsc -b && pnpm --filter @coloride/web-ui build && pnpm --filter @coloride/desktop-tauri build",
    "test:performance": "vitest run --config vitest.performance.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tauri-apps/cli": "2.12.4",
    "@vtsls/language-server": "0.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "5.7.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
