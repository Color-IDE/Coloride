{
  "name": "@coloride/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/tailwind.css"
  },
  "dependencies": {
    "@coloride/editor-cm6": "workspace:*",
    "@coloride/protocol-types": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i ./src/theme/tailwind.css -o ./dist/tailwind.css",
    "build:css": "tailwindcss -i ./src/theme/tailwind.css -o ./dist/tailwind.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  }
}
