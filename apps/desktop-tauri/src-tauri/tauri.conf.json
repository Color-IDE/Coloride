{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coloride",
  "version": "0.1.0",
  "identifier": "dev.coloride.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @coloride/web-ui build && pnpm dev:watch",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @coloride/web-ui build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coloride",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
